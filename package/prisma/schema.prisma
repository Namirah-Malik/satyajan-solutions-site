generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  SKU              String?
  description      String?
  price            Float?
  rate             Float?
  images           String[]
  video            String?
  slug             String?
  tags             String[]
  salient_features String[]
  features         String[]
  specifications   Json[]
  data             Json[]
  category         String?
  stockStatus      String?
  capacity         String?
  isBestSeller     Boolean?
  isNew            Boolean?
  createdAt        DateTime? @default(now())
}